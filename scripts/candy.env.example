# Copy to scripts/candy.env to override build settings locally.
# This file is git-ignored.

# Android SDK / NDK
# ANDROID_HOME=/path/to/android-sdk
# ANDROID_NDK_ROOT=/path/to/android-sdk/ndk/27.2.12479018
# NDK_VERSION=27.2.12479018

# Minimum API level the native code is compiled against (must match minSdk).
# ANDROID_API=26

# Parallelism for the OpenSSL/Poco builds.
# JOBS=8

# Where the third-party sources live and where the built libraries go.
# THIRD_PARTY_DIR=/path/to/candy-android/deps-src
# DEPS_DIR=/path/to/candy-android/native-deps

# Explicit tool paths, if they are not on PATH.
# PERL=/usr/bin/perl
# MAKE=/usr/bin/make
# CMAKE=/path/to/cmake
# NINJA=/path/to/ninja
# CMAKE_DIR=/path/to/cmake-install   # dir containing bin/cmake.exe + bin/ninja.exe

# APK build (JDK 17 + Gradle 8.11.1).
# JAVA_HOME=/path/to/jdk-17
# GRADLE_HOME=/path/to/gradle-8.11.1
# GRADLE=/path/to/gradle            # explicit launcher, wins over GRADLE_HOME
